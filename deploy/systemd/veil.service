[Unit]
Description=veil VPN client
Documentation=https://github.com/Antoinenz/veil
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Enroll first: `sudo veil login --data-dir /etc/veil <host> <invite>`.
# Runs the background daemon; connect with `veil ctl connect [--full]` or the GUI.
ExecStart=/usr/local/bin/veil daemon --data-dir /etc/veil
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
# Creates /run/veil for the control socket.
RuntimeDirectory=veil
ReadWritePaths=/etc/veil

[Install]
WantedBy=multi-user.target
